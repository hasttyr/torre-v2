{
  "name": "torre",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma de torneos de ajedrez universitarios (ASCUN).",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --workspace-concurrency=4 run typecheck",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=reports/vitest.json --reporter=junit --outputFile.junit=reports/junit.xml --reporter=blob --outputFile.blob=reports/blob/unit.json",
    "test:coverage": "vitest --merge-reports=reports/blob --config vitest.coverage.config.ts --coverage --reporter=dot",
    "test:trace": "node tools/test-trace.mjs",
    "test:manifest": "node tools/run-manifest.mjs",
    "test:report": "node tools/test-report.mjs",
    "test:nightly": "node tools/nightly.mjs",
    "test:e2e": "node tools/run-e2e.mjs",
    "test:smoke": "node tools/smoke.mjs",
    "bench": "node tools/bench.mjs",
    "build": "pnpm -r run build",
    "dev": "node tools/dev.mjs",
    "dev:infra": "node tools/infra.mjs up",
    "dev:infra:down": "node tools/infra.mjs down",
    "infra:check": "node tools/infra.mjs check",
    "db:migrate": "pnpm --filter @torre/api db:migrate",
    "db:deploy": "pnpm --filter @torre/api db:deploy",
    "db:status": "pnpm --filter @torre/api db:status",
    "db:seed": "pnpm --filter @torre/api db:seed",
    "permissions:sync": "pnpm --filter @torre/api permissions:sync",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "secrets": "node tools/gitleaks.mjs",
    "check:floor": "node tools/floor-guard.mjs",
    "verify:fast": "node tools/verify-fast.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm depcruise && pnpm test",
    "verify:full": "pnpm verify && pnpm test:e2e"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@torre/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "fast-check": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs,vue}": [
      "eslint --max-warnings=0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,css}": [
      "prettier --write"
    ]
  }
}
