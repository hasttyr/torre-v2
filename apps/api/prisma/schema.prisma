// Data model of the API (ARCHITECTURE.md §8). Every change is a versioned SQL migration under
// prisma/migrations (`pnpm --filter @torre/api db:migrate` locally, `db:deploy` elsewhere);
// `prisma db push` is forbidden (US-007:AC1). Tables are snake_case; ids are UUID v7 generated by
// the server (DEC-026); times are timestamptz in UTC.

generator client {
  provider            = "prisma-client"
  output              = "../src/database/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Universities (ARCHITECTURE.md §8.1). Global catalogue: no organization_id and no RLS.
/// Deletion is logical (DEC-059): the application role has no DELETE privilege.
model Institution {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String
  sniesCode       String?   @map("snies_code")
  city            String
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?   @map("deleted_by") @db.Uuid
  deleteReason    String?   @map("delete_reason")
  deletionBatchId String?   @map("deletion_batch_id") @db.Uuid

  @@map("institutions")
}

/// Accounts (ARCHITECTURE.md §8.1, US-022). Global: no organization_id and no RLS. A new account has no
/// membership, so it is a viewer (BR-ROLE-01). The email is stored lower-case and unique among live rows.
model User {
  id                   String         @id @default(uuid(7)) @db.Uuid
  email                String
  displayName          String         @map("display_name")
  passwordHash         String         @map("password_hash")
  locale               String         @default("es")
  theme                String?
  emailVerifiedAt      DateTime?      @map("email_verified_at") @db.Timestamptz(6)
  status               String         @default("ACTIVE")
  twoFactorSecret      String?        @map("two_factor_secret")
  twoFactorConfirmedAt DateTime?      @map("two_factor_confirmed_at") @db.Timestamptz(6)
  privacyPolicyVersion String         @map("privacy_policy_version")
  privacyAcceptedAt    DateTime       @map("privacy_accepted_at") @db.Timestamptz(6)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?      @map("deleted_at") @db.Timestamptz(6)
  deletedBy            String?        @map("deleted_by") @db.Uuid
  deleteReason         String?        @map("delete_reason")
  deletionBatchId      String?        @map("deletion_batch_id") @db.Uuid
  sessions             AuthSession[]
  refreshTokens        RefreshToken[]
  memberships          Membership[]   @relation("MembershipUser")
  grantedMemberships   Membership[]   @relation("MembershipGrantedBy")
  revokedMemberships   Membership[]   @relation("MembershipRevokedBy")

  @@map("users")
}

/// One session per refresh family (BR-AUTH-02): it lasts 24 hours from the login, whatever the rotations.
model AuthSession {
  id                  String         @id @default(uuid(7)) @db.Uuid
  userId              String         @map("user_id") @db.Uuid
  user                User           @relation(fields: [userId], references: [id])
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt          DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt           DateTime       @map("expires_at") @db.Timestamptz(6)
  userAgent           String?        @map("user_agent")
  ipHash              String?        @map("ip_hash")
  passwordConfirmedAt DateTime?      @map("password_confirmed_at") @db.Timestamptz(6)
  twoFactorPassedAt   DateTime?      @map("two_factor_passed_at") @db.Timestamptz(6)
  revokedAt           DateTime?      @map("revoked_at") @db.Timestamptz(6)
  refreshTokens       RefreshToken[]

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

/// Opaque refresh tokens, stored as SHA-256 hashes; rotation links each one to its successor (INV-A-1).
model RefreshToken {
  id         String      @id @default(uuid(7)) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  user       User        @relation(fields: [userId], references: [id])
  familyId   String      @map("family_id") @db.Uuid
  family     AuthSession @relation(fields: [familyId], references: [id])
  tokenHash  String      @unique @map("token_hash")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime    @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?   @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?     @map("replaced_by") @db.Uuid

  @@index([familyId])
  @@map("refresh_tokens")
}

/// Actions outside the tournament streams (ARCHITECTURE.md §8.1): security events since US-022b. Insert
/// only (DEC-077): the application role cannot update or delete and a trigger refuses it to anyone.
/// Ids without foreign keys, so the trail never blocks anything; no personal data, only ids and hashes.
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  targetType     String?  @map("target_type")
  targetId       String?  @map("target_id") @db.Uuid
  reason         String?
  changes        Json?
  ipHash         String?  @map("ip_hash")
  correlationId  String?  @map("correlation_id")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([actorUserId, occurredAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}

/// Tenants (ARCHITECTURE.md §8.1, US-023): a university, league or federation. Only a platform_admin
/// creates one directly (DEC-056). It always keeps a live org_owner: a deferred trigger checks it at
/// every commit. The slug is unique among live organizations (partial index in the migration).
model Organization {
  id              String       @id @default(uuid(7)) @db.Uuid
  name            String
  slug            String
  logoKey         String?      @map("logo_key")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?      @map("deleted_by") @db.Uuid
  deleteReason    String?      @map("delete_reason")
  deletionBatchId String?      @map("deletion_batch_id") @db.Uuid
  memberships     Membership[]
  roles           Role[]

  @@map("organizations")
}

/// Roles (ARCHITECTURE.md §8.1): the seven system roles (organization_id null, inserted by the
/// migration of US-023) and, with US-108, an organization's own roles. Their permissions arrive with
/// US-024 (role_permissions). The key is unique per organization among live rows (partial index).
model Role {
  id              String           @id @default(uuid(7)) @db.Uuid
  organizationId  String?          @map("organization_id") @db.Uuid
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  key             String
  name            String
  scopeType       String           @map("scope_type")
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?          @map("deleted_by") @db.Uuid
  deleteReason    String?          @map("delete_reason")
  deletionBatchId String?          @map("deletion_batch_id") @db.Uuid
  memberships     Membership[]
  permissions     RolePermission[]

  // Target of the memberships' (role_id, scope_type) key: a role is only granted in its own scope.
  @@unique([id, scopeType])
  @@map("roles")
}

/// A role of a user in a scope (AUTHORIZATION.md §2–§3, §9). Audited CRUD, not event-sourced
/// (ARCHITECTURE.md §7.1): a membership is never deleted, it is revoked. One live membership per user,
/// role and scope (partial index); organization_id and scope_id are null only in the PLATFORM scope.
model Membership {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String        @map("user_id") @db.Uuid
  user           User          @relation("MembershipUser", fields: [userId], references: [id])
  scopeType      String        @map("scope_type")
  scopeId        String?       @map("scope_id") @db.Uuid
  roleId         String        @map("role_id") @db.Uuid
  role           Role          @relation(fields: [roleId, scopeType], references: [id, scopeType])
  source         String
  grantedBy      String?       @map("granted_by") @db.Uuid
  grantedByUser  User?         @relation("MembershipGrantedBy", fields: [grantedBy], references: [id], onDelete: Restrict)
  grantReason    String?       @map("grant_reason")
  /// The approved role request (US-029); its foreign key arrives with that table.
  roleRequestId  String?       @map("role_request_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt      DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokedBy      String?       @map("revoked_by") @db.Uuid
  revokedByUser  User?         @relation("MembershipRevokedBy", fields: [revokedBy], references: [id], onDelete: Restrict)
  revokeReason   String?       @map("revoke_reason")

  @@index([userId, revokedAt])
  @@index([scopeType, scopeId])
  @@map("memberships")
}

/// The fixed catalogue of permissions (AUTHORIZATION.md §4.1, US-024): loaded from @torre/contracts by
/// `permissions:sync` with the migration role; the application role only reads it.
model Permission {
  key         String           @id
  group       String
  description String
  reserved    Boolean
  /// Scopes where a role holding it may be granted; empty for the permissions of the own account.
  scopeTypes  String[]         @map("scope_types")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

/// The permissions of a role (DEC-058). The system roles get the matrix of AUTHORIZATION.md §4 when a
/// permission first enters the catalogue; a trigger keeps reserved permissions on platform_admin only
/// (INV-T-6) and each permission within its scopes.
model RolePermission {
  roleId        String     @map("role_id") @db.Uuid
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permissionKey String     @map("permission_key")
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}
