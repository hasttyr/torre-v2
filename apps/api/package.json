{
  "name": "@torre/api",
  "version": "0.0.0",
  "private": true,
  "description": "API NestJS.",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "tsc -p tsconfig.build.json && node dist/database/seed.main.js",
    "jobs:retry": "tsc -p tsconfig.build.json && node dist/jobs/retry.main.js"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/openapi-client": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@torre/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/passport-jwt": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "prisma": "catalog:",
    "supertest": "catalog:",
    "testcontainers": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/passport": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/nest": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@torre/contracts": "workspace:*",
    "@torre/core": "workspace:*",
    "argon2": "catalog:",
    "bullmq": "catalog:",
    "helmet": "catalog:",
    "ioredis": "catalog:",
    "nestjs-cls": "catalog:",
    "nestjs-pino": "catalog:",
    "passport": "catalog:",
    "passport-jwt": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  }
