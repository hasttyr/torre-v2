# Torre — environment variables (ARCHITECTURE.md §16.2). Copy to .env and adjust.
# Every value here is a DEVELOPMENT-ONLY placeholder that matches docker-compose.yml.
# Never reuse these values outside a local machine.

# --- Local infrastructure ports (docker-compose.yml and `pnpm dev:infra`) ---
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- API: basics ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
WORKER=false

# --- Database (roles from infra/postgres/init) ---
DATABASE_URL=postgresql://torre_app:torre_app_dev@localhost:5432/torre?schema=public
DATABASE_MIGRATION_URL=postgresql://torre_migrator:torre_migrator_dev@localhost:5432/torre?schema=public
# Maintenance role with BYPASSRLS and privileges only on the tables it purges (US-117, DEC-078);
# created by infra/postgres/init/01-roles.sql, required with WORKER=true.
DATABASE_MAINTENANCE_URL=postgresql://torre_maintenance:torre_maintenance_dev@localhost:5432/torre?schema=public

# Integration tests (`pnpm test:e2e`, US-007) start PostgreSQL with Testcontainers. Without Docker,
# point them at the superuser of an existing server instead (the native cluster of `pnpm dev:infra`):
# TEST_DATABASE_ADMIN_URL=postgresql://postgres:torre_dev_postgres@127.0.0.1:55432/postgres
# Same for Redis: an existing Valkey (the native one of `pnpm dev:infra`) with a database index of its own.
# TEST_REDIS_URL=redis://127.0.0.1:6379/15

# --- Redis / Valkey ---
REDIS_URL=redis://localhost:6379

# --- Authentication (DEC-062) ---
JWT_ACCESS_SECRET=dev-only-jwt-access-secret-change-me
JWT_ACCESS_TTL=5m
REFRESH_TTL_HOURS=24
COOKIE_SECURE=false
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# Comma-separated id:base64(32 bytes). "dev1" is the base64 of a readable 32-byte dev-only string.
TWO_FACTOR_ENCRYPTION_KEYS=dev1:ZGV2LW9ubHktMzItYnl0ZS1rZXktY2hhbmdlLW1lISE=
TWO_FACTOR_ACTIVE_KEY_ID=dev1
PASSWORD_CONFIRMATION_TTL=15m
# Key of the HMAC that stores client addresses only as hashes (sessions and audit_log, DEC-096).
IP_HASH_SECRET=dev-only-ip-hash-secret-change-me-now

# --- Rate limits (DEC-062) ---
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_WINDOW=15m
AUTH_LOCKOUT_DURATION=15m
API_THROTTLE_LIMIT=300

# --- Input limits (DEC-075, DEC-076) ---
BODY_LIMIT=1mb
IMPORT_MAX_BYTES=2097152
IMPORT_MAX_ROWS=5000
LOGO_MAX_BYTES=524288
WS_MAX_ROOMS=10
WS_MAX_MESSAGE_BYTES=4096
WS_MAX_MESSAGES_PER_MINUTE=30

# --- Behaviour ---
IDEMPOTENCY_TTL_DAYS=7
LIVE_COALESCE_MS=200
METRICS_TOKEN=dev-only-metrics-token-change-me
# Test hooks: the API refuses to start with true in production.
E2E_TEST_HOOKS=false

# --- Web origin, links and CORS ---
CORS_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# --- S3-compatible storage (RustFS locally, ADR-0003) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=torre-dev
S3_ACCESS_KEY=torre-dev-access
S3_SECRET_KEY=torre-dev-secret-change-me

# --- Email (Mailpit locally, OQ-006) ---
MAIL_PROVIDER=smtp
MAIL_FROM="Torre (dev) <no-reply@torre.localhost>"
SMTP_URL=smtp://localhost:1025

# --- Observability (optional) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Web (Vite exposes only VITE_*; never secrets) ---
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_WS_URL=ws://localhost:3000
VITE_DEFAULT_LOCALE=es
